# Copy to .env and fill in. Defaults assume a local Ollama server.
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gemma4:12b
# Only needed for a hosted OpenAI-compatible endpoint instead of local Ollama.
LLM_API_KEY=

# Stage 1: Open Targets (public, no key). Set only for a non-default instance.
# OPEN_TARGETS_BASE_URL=https://api.platform.opentargets.org/api/v4/graphql

# Stage 1: PubMed E-utilities (both optional). An email and API key raise the rate limit.
PUBMED_EMAIL=
PUBMED_API_KEY=

# Stage 3: GTEx tissue expression (public, no key). Set only for a non-default instance.
# GTEX_BASE_URL=https://gtexportal.org/api/v2
# GTEX_DATASET_ID=gtex_v8

# Stage 3: GWAS Catalog (public, no key). Set only for a non-default instance.
# GWAS_CATALOG_BASE_URL=https://www.ebi.ac.uk/gwas/rest/api/v2

# Stage 4: MIMIC-IV. Folder containing hosp/diagnoses_icd.csv.gz and hosp/d_icd_diagnoses.csv.gz.
MIMIC_DATA_DIR=
