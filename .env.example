# Copy to .env and fill in. Defaults assume a local Ollama server.
LLM_BASE_URL=http://localhost:11434
# gemma4:12b (7.6 GB), confirmed via `ollama list` on this machine (2026-09-04).
# The larger gemma4-31b-q6k:latest (25 GB) was pulled and then removed --
# too much RAM. If you pull a different/larger model later, update this to
# match its exact tag from `ollama list`.
LLM_MODEL=gemma4:12b
# Only needed if LLM_BASE_URL points at a hosted OpenAI-compatible endpoint instead of local Ollama.
LLM_API_KEY=

# Agent 1 -- Open Targets (sub-agent 1). Public API, no key needed; only
# set this if you're pointed at a non-default Open Targets instance.
# OPEN_TARGETS_BASE_URL=https://api.platform.opentargets.org/api/v4/graphql

# Agent 1 -- PubMed E-utilities (sub-agent 2). Both optional, but NCBI's
# usage policy asks for an identifying email and rewards it (and an API
# key) with a higher rate limit. Get a free key at
# https://www.ncbi.nlm.nih.gov/account/settings/ (API Key Management).
PUBMED_EMAIL=
PUBMED_API_KEY=

# Agent 3 -- tissue-expression check. GTEx is public, no key needed;
# only set these if you're pointed at a non-default instance.
# GTEX_BASE_URL=https://gtexportal.org/api/v2
# GTEX_DATASET_ID=gtex_v10

# Agent 3 -- cross-database gene-disease association check. GWAS Catalog
# is public, no key needed; only set this for a non-default instance.
# GWAS_CATALOG_BASE_URL=https://www.ebi.ac.uk/gwas/rest/api

# Agent 4 -- MIMIC-IV. Local folder containing MIMIC-IV's hosp/
# directory (hosp/diagnoses_icd.csv.gz + hosp/d_icd_diagnoses.csv.gz).
# You only need those two files, not the full dataset download -- see
# PipelineB/agent4_mimic.py's module docstring.
MIMIC_DATA_DIR=

# BioPathBench scoring -- Hallucination Rate (metrics/gene_reference.py,
# metrics/benchmark.py). Local path to HGNC's complete gene set (public,
# no credentials needed). Download once:
#   curl -o hgnc_complete_set.txt https://ftp.ebi.ac.uk/pub/databases/genenames/hgnc/tsv/hgnc_complete_set.txt
HGNC_GENE_LIST_PATH=
